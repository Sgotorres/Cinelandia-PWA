{
  "name": "cinelandia-sistema-pedidos",
  "version": "2.0.0",
  "private": true,
  "description": "Sistema integrado con arquitectura Monorepo",
  "workspaces": [
    "backend",
    "admin-desktop"
  ],
  "scripts": {
    "dev:backend": "pnpm --filter backend start",
    "dev:admin": "pnpm --filter admin-desktop start",
    "start": "concurrently \"pnpm run dev:backend\" \"pnpm run dev:admin\""
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}

{
  "name": "cinelandia-sistema-pedidos",
  "version": "2.0.0",
  "private": true,
  "description": "Sistema integrado con arquitectura Monorepo",
  "workspaces": [
    "backend",
    "admin-desktop"
  ],
  "scripts": {
    "dev:backend": "npm run start --workspace=backend",
    "dev:admin": "npm run start --workspace=admin-desktop",
    "start": "npx concurrently \"npm run dev:backend\" \"npm run dev:admin\""
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
